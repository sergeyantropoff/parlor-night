# Локальные значения для первого запуска. Перед доступом из сети замените SECRET_KEY.
ENV=local
SECRET_KEY=replace-this-local-dev-key-with-32chars-min
DATABASE_URL=postgresql://boardmentor:boardmentor@db:5432/boardmentor
POSTGRES_USER=boardmentor
POSTGRES_PASSWORD=boardmentor
POSTGRES_DB=boardmentor
POSTGRES_PORT=54329
WEB_PORT=8000

COOKIE_SECURE=false
SESSION_TTL_HOURS=336
TRUST_PROXY=false
FORWARDED_ALLOW_IPS=127.0.0.1
TRUSTED_HOSTS=localhost,127.0.0.1,web

CHESS_ENGINE_PATH=/usr/games/stockfish
CHESS_ENGINE_POOL_SIZE=2
CHESS_ENGINE_HASH_MB=16
CHESS_ENGINE_THREADS=1
CHECKERS_WORKERS=2
ENGINE_MAX_CONCURRENT=2
ENGINE_MAX_TIME_MS=10000
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
ENGINE_RATE_PER_MINUTE=300
VALKEY_URL=redis://valkey:6379/0
# local — движки в процессе сайта. remote — очередь Valkey и отдельный под.
ENGINE_MODE=local
# Пустые секрет и хост: браузер получает только публичный STUN.
TURN_SECRET=
TURN_HOST=
TURN_PORT=3478
TURN_TLS_PORT=5349
REQUEST_LIMIT=240
REQUEST_WINDOW_SECONDS=10
MAX_BODY_BYTES=65536
NEWS_IMAGE_DIR=/var/lib/parlor/news
NEWS_IMAGE_BYTES=4194304

ALLOW_REGISTRATION=false
LOG_LEVEL=INFO
ARGON_TIME_COST=2
ARGON_MEMORY_COST=32768
ARGON_PARALLELISM=1
